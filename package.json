{
  "name": "apps-of-dots",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MCP integrations for OpenAI dots",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "apps-of-dots": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm -r build && tsc -p tsconfig.json && node core/scripts/copy-ui.mjs",
    "apps-of-dots": "node dist/cli.js",
    "dev": "tsx core/src/cli.ts",
    "test": "pnpm build && node --import tsx --test core/test/*.test.ts discord/test/*.test.ts discord/server/test/*.test.ts telegram/test/*.test.ts whatsapp/test/*.test.ts core/packages/runtime/test/*.test.ts core/packages/managed-mcp/test/*.test.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test:servers": "pnpm build && node --import tsx core/test/server-contracts.mts",
    "format": "prettier --write .",
    "check": "prettier --check . && pnpm typecheck"
  },
  "dependencies": {
    "@apps-of-dots/discord": "workspace:*",
    "@apps-of-dots/managed-mcp": "workspace:*",
    "@apps-of-dots/runtime": "workspace:*",
    "@apps-of-dots/telegram": "workspace:*",
    "@apps-of-dots/whatsapp": "workspace:*",
    "commander": "15.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
